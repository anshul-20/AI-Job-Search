# OpenRouter API Key (get from https://openrouter.ai/keys)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Ultra-Cheap / High Performance Model Choices:
# 1. DeepSeek-V3 (~$0.14 / 1M tokens - 99% cheaper than Claude/GPT-4):
# OPENROUTER_MODEL=deepseek/deepseek-chat
# 2. Google Gemini 2.0 Flash (Fast, very cheap):
# OPENROUTER_MODEL=google/gemini-2.0-flash-001
# 3. NVIDIA Nemotron (Strong instruction following & anti-hallucination):
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b
# 4. 100% Free OpenRouter test models (may have queues):
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Custom Base URL (Optional - set to http://localhost:11434/v1 for 100% free local Ollama)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# RESUME_PATH=data/resume.json
# OUTPUT_DIR=output
# MAX_BULLETS_PER_ROLE=5
# MAX_PROJECTS=3
# LLM_TEMPERATURE=0.2
# PORT=3000

# # Automated Search & Apply Preferences (Runs 3x daily)
# AUTO_SEARCH_KEYWORDS=React Native
# AUTO_SEARCH_LOCATION=India and Remote
# # Source: set to "careers" for only official company ATS portals (Greenhouse, Lever, Ashby, etc.),
# # or "all" to include LinkedIn, Indeed, Naukri & RemoteOK as well:
# AUTO_SEARCH_SOURCE=all
# AUTO_MIN_MATCH_PCT=70
# AUTO_MAX_JOBS_PER_RUN=5
